{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ma9eo/keymap-visualization/renderer/schema.json",
  "title": "キーマップ可視化 中間データ",
  "description": "キーマップ可視化 デザインルール v0.3 の中間データ。キーマップを解析し、入力項目を確定させた結果を表す。座標は 1u = 100 の単位で表す。",
  "type": "object",
  "required": ["meta", "layers", "keys"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "description": "ヘッダ・メタ情報と、描画に使う入力項目（第10.0節・第10.7節）",
      "required": ["keyboard", "os", "split", "source"],
      "additionalProperties": false,
      "properties": {
        "keyboard": { "type": "string", "description": "キーボード名（実機のサイズを含む）" },
        "split": { "type": "boolean", "description": "分割型なら true、一体型なら false（第10.0節）。キーの間隔からは推定しない。true のときは、左半分と右半分が横方向に重ならず、間が1u以上空く座標で keys を書く（第10.10節）" },
        "os": { "type": "string", "description": "対象OS" },
        "language": { "type": "string", "enum": ["ja", "en"], "default": "ja", "description": "表示言語" },
        "hostLayout": { "type": "string", "description": "ホストのキーボード配列（US・JISなど）。記号の解釈に使った値を記録する。図には表示しない" },
        "source": {
          "type": "object",
          "required": ["repo", "commit"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "description": "リポジトリ" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "コミットハッシュ（ファイルの blob ハッシュではない）" },
            "path": { "type": "string", "description": "キーマップのファイルパス" }
          }
        },
        "spec": { "type": "string", "description": "本仕様のバージョン" },
        "title": { "type": "string", "description": "見出し。省略時は「キーボード名 キーマップ — OS」" }
      }
    },
    "layers": {
      "type": "array",
      "description": "追加レイヤー。並び順が表示スロットの順（第3.2節）。図を分ける場合は、すべての図に全レイヤーを同じ順で書き、この図に表示しないレイヤーには show: false を付ける。表示するレイヤーは6つまで",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "データ内で参照するための識別子" },
          "name": { "type": "string", "description": "表示名（第3.1節）" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "レイヤー色。省略時はテーマのレイヤー色を順に使う" },
          "show": { "type": "boolean", "default": true, "description": "false にすると、この図ではセルを持たず、凡例にも載せない。レイヤー切り替えやComboの色と名前には使う（第3.2節）" }
        }
      }
    },
    "keys": {
      "type": "array",
      "description": "描画するキー。使っていないキーは id・x・y だけを書き、薄い枠で描く。表示しないキーは含めない（第9.0.1節）",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number", "description": "キーの左上の横位置（1u = 100）" },
          "y": { "type": "number", "description": "キーの左上の縦位置（1u = 100）" },
          "rot": { "type": "number", "description": "回転角（度、時計回り）" },
          "rx": { "type": "number", "description": "回転の中心の横位置（省略時はキーの中心）" },
          "ry": { "type": "number", "description": "回転の中心の縦位置（省略時はキーの中心）" },
          "base": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" }, "icon": { "const": "one-shot", "description": "ワンショット修飾キー（第4.7節）" } } }
            ],
            "description": "基本入力。ワンショット修飾キーは { text, icon: \"one-shot\" }"
          },
          "cells": {
            "type": "object",
            "description": "追加レイヤーの出力。キーはレイヤーの id。長い名前には短縮表記を、ワンショット修飾キーにはアイコンを添えられる",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["text"],
                  "additionalProperties": false,
                  "properties": {
                    "text": { "type": "string", "description": "正式名" },
                    "icon": { "const": "one-shot", "description": "ワンショット修飾キー（第4.7節）" },
                    "short": { "type": "string", "description": "短縮表記。セルに収まらないときに描画プログラムが使い、正式名をそのキーの注釈に載せる（第10.4節）。記号1文字だけにはしない" }
                  }
                }
              ]
            }
          },
          "hold": { "type": "string", "description": "Hold の機能名（レイヤー切り替え以外）" },
          "taps": {
            "type": "array",
            "description": "Tap Dance（レイヤー切り替え以外）",
            "items": {
              "type": "object",
              "required": ["icon", "text"],
              "additionalProperties": false,
              "properties": {
                "icon": { "type": "string", "enum": ["tap-2", "tap-3"] },
                "text": { "type": "string" }
              }
            }
          },
          "switch": {
            "type": "object",
            "description": "レイヤー切り替え（第4.3節）",
            "required": ["layer", "via"],
            "additionalProperties": false,
            "properties": {
              "layer": { "type": "string", "description": "切り替え先レイヤーの id" },
              "via": { "type": "string", "enum": ["hold", "tap-2", "tap-3", "toggle", "to", "one-shot"], "description": "切り替える操作" }
            }
          },
          "note": { "type": "string", "description": "そのキーの注釈の本文（第8章）。番号とマーカーは描画プログラムが付ける" }
        }
      }
    },
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keys", "text", "kind"],
        "additionalProperties": false,
        "properties": {
          "keys": { "type": "array", "minItems": 2, "items": { "type": "string" }, "description": "構成キーの id" },
          "text": { "type": "string", "description": "機能名。レイヤー切り替え（go）では切り替え先レイヤーの名前か、切り替える目的" },
          "short": { "type": "string", "description": "短縮表記。ラベルが収まらないときに描画プログラムが使い、正式名をCombo欄に載せる（第6.1節・第10.4節）。記号1文字だけにはしない" },
          "note": { "type": "string", "description": "Comboの補足（有効条件など）。Combo欄に載せる（第6章）" },
          "kind": {
            "type": "string",
            "enum": ["base", "layer", "go"],
            "description": "base：レイヤーに関係なく有効／layer：そのレイヤーにいる間だけ有効／go：そのレイヤーへ行く（第3.1節）"
          },
          "layer": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 2, "items": { "type": "string" } }], "description": "kind が layer・go のときのレイヤーの id。layer で複数の追加レイヤーで有効な場合は配列にする（go は1つだけ）" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "enum": ["layer", "go"] } } }, "then": { "required": ["layer"] } }
        ]
      }
    },
    "notes": {
      "type": "array",
      "description": "キーに属さない注釈の本文（第8.2節）。1項目に1つの内容を1文で書く。番号なしで注釈欄の末尾に載せる。キーの注釈は keys[].note に書く",
      "items": { "type": "string" }
    }
  }
}
